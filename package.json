{
  "name": "compendium",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc",
    "build:check": "tsc --noEmit",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "lint": "biome lint --diagnostic-level=error",
    "lint:all": "biome lint",
    "test": "vitest",
    "test:py": "python -m coverage run --module pytest -v && python -m coverage report -m",
    "coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "chance": "1.1.13",
    "express": "5.2.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-conventional": "20.3.1",
    "@tsconfig/node24": "24.0.3",
    "@types/benchmark": "2.1.5",
    "@types/express": "5.0.6",
    "@types/node": "24.10.4",
    "@vitest/browser": "4.0.16",
    "@vitest/coverage-v8": "4.0.16",
    "benchmark": "^2.1.4",
    "prettier": "3.7.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  }
}
