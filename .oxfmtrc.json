{
  "$schema": "node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "bracketSameLine": false,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "useTabs": false,
  "sortPackageJson": false,
  "ignorePatterns": [],
  "sortImports": {
    "newlinesBetween": true,
    "groups": [
      "type-import",
      "builtin",
      "external",
      "type-internal",
      "value-internal",
      ["type-parent", "type-sibling", "type-index"],
      ["value-parent", "value-sibling", "value-index"],
      "side_effect",
      "unknown"
    ],
  }
}
